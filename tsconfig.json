{
	"compilerOptions": {
		"target": "ES2021",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"noPropertyAccessFromIndexSignature": true,
		"skipLibCheck": true,
		"allowJs": true,
		"noEmit": true,
		"paths": {
			"mediabunny-avi": ["./src/index.ts"],
		},
	},
	"include": [
		"./src/**/*",
		"./test/**/*.ts",
		"./scripts/**/*",
		"./vitest.config.ts",
		"./vite.config.ts",
		"./demo/**/*.ts",
	],
}
