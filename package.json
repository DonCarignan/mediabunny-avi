{
  "name": "mediabunny-avi",
  "author": "Don Carignan",
  "version": "0.1.0",
  "description": "AVI container extension for Mediabunny.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DonCarignan/mediabunny-avi.git"
  },
  "homepage": "https://github.com/DonCarignan/mediabunny-avi#readme",
  "bugs": {
    "url": "https://github.com/DonCarignan/mediabunny-avi/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "README.md",
    "LIMITATIONS.md",
    "package.json",
    "LICENSE",
    "dist",
    "src"
  ],
  "sideEffects": false,
  "license": "MPL-2.0",
  "scripts": {
    "build": "./scripts/build.sh",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "vitest --run",
    "demo": "npm run build && vite",
    "demo:build": "npm run build && vite build"
  },
  "peerDependencies": {
    "mediabunny": ">=2.0.0-0 <3"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.1",
    "eslint": "^9.22.0",
    "mediabunny": "file:vendor/mediabunny-1.50.7.tgz",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "media",
    "avi",
    "opendml",
    "demuxer",
    "mediabunny"
  ]
}
